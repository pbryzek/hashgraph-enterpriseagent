# Hedera testnet credentials (get a free account at portal.hedera.com)
HEDERA_ACCOUNT_ID=0.0.xxxxxx
HEDERA_PRIVATE_KEY=your_ed25519_or_ecdsa_private_key
HEDERA_NETWORK=testnet

# NatureBackers indexer base URL (no trailing slash)
NATURE_BACKERS_API_URL=https://indexer.guardianservice.app/api/v1/mainnet

# Bearer token for the NatureBackers indexer API (get from Nature Backers admin panel)
NATURE_BACKERS_TOKEN=your_nature_backers_bearer_token

# Set to "true" to use built-in fake project data instead of hitting the live API.
# Set to "false" (or remove) once NATURE_BACKERS_TOKEN is configured.
FAKE_INDEXER=false

# Frontend URL — used to generate voting URLs and QR codes in campaign creation
# In development: http://localhost:5173  |  In production: your deployed domain
FRONTEND_URL=http://localhost:5173

# LLM provider — set one of: "gemini", "openai", "anthropic" (default: openai)
LLM_PROVIDER=gemini

# Gemini (free tier — aistudio.google.com)
GOOGLE_API_KEY=your_google_ai_key
GEMINI_MODEL=gemini-2.5-flash-lite-preview-06-17

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL_NAME=gpt-4o

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_key

PORT=3001
